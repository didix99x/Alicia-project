# ---------------------------------------------------------------
# Configuração da Alicia. O Iniciar_Alicia.bat copia este arquivo
# para ".env" na primeira execução e pede a sua chave.
# O arquivo .env é IGNORADO pelo Git. Nunca compartilhe a chave.
# ---------------------------------------------------------------

# Chave criada em https://build.nvidia.com (Settings > API Keys). Começa com nvapi-
NVIDIA_API_KEY=COLE_SUA_CHAVE_AQUI

# Modelo de chat. Confira os disponíveis para a sua conta em https://build.nvidia.com/models
# O iniciador testa este modelo com uma mensagem curta; se não estiver disponível na sua conta,
# escolhe sozinho o melhor da lista de preferência e grava aqui.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# API compatível com OpenAI da NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Opcionais
# NVIDIA_TIMEOUT=60
# NVIDIA_MAX_RETRIES=2
# ALICIA_LOG_LEVEL=INFO
